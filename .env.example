# Telegram (MTProto / Telethon) — личный аккаунт
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_session
TELEGRAM_PHONE=

# Admin Bot (Telegram Bot API — создаётся через @BotFather)
ADMIN_BOT_TOKEN=
ADMIN_USER_ID=

# Режим работы
AUTO_REPLY=true
REPLY_DELAY=1
BATCH_WINDOW=2

# Web App (Telegram) — публичный URL сервера (https://domain.com)
WEB_APP_BASE_URL=
